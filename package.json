{
  "name": "pdt42",
  "version": "0.0.0",
  "private": true,
  "license": "CC-BY-SA-4.0",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "test": "vp test",
    "check": "vp check",
    "ready": "pnpm run check && pnpm run test && pnpm run build",
    "pdt42": "node --conditions=development --experimental-strip-types --no-warnings packages/cli/src/cli.ts",
    "validate:example": "pnpm pdt42 --dir examples/harvest-commons validate",
    "docs:meta-model": "node --experimental-strip-types --no-warnings scripts/meta-model-doc.ts",
    "demo": "pnpm --filter @pdt42/web demo",
    "site": "pnpm --filter @pdt42/site build && pnpm pdt42 --dir examples/harvest-commons build --out packages/site/dist/harvest-commons"
  },
  "devDependencies": {
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/exec": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/npm": "catalog:",
    "semantic-release": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@10.32.1"
}

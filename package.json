{
  "name": "editable-pdt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "test": "vp test",
    "check": "vp check",
    "ready": "pnpm run check && pnpm run test && pnpm run build",
    "pdt": "node --conditions=development --experimental-strip-types --no-warnings packages/cli/src/cli.ts",
    "validate:example": "pnpm pdt --dir examples/harvest-commons validate"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@10.32.1"
}
